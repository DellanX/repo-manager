{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI (uvicorn)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.server:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "REPO_MANAGER_WORKSPACE": "${workspaceFolder}"
      },
      "jinja": true,
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
