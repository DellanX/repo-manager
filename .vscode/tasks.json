{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Python dependencies",
      "type": "shell",
      "command": "python -m pip install --no-cache-dir -r requirements.txt",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run API (uvicorn)",
      "type": "shell",
      "command": "python -m uvicorn src.server:app --host 0.0.0.0 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running on",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
